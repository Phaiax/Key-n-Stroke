<Window x:Class="KeyNStroke.DrawWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KeyNStroke"
        mc:Ignorable="d"
        Title="Draw"
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        Background="#1E1E24">
    <Window.Resources>
        <Style x:Key="ToolbarToolBtn" TargetType="RadioButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="#55FFFFFF" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF3B82F6"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarActionBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorPaletteBtn" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="9" BorderBrush="#77FFFFFF" BorderThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Floating Annotation Toolbar -->
        <Border Grid.Row="0"
                Background="#EE1E1E24" 
                Padding="8,5" 
                BorderBrush="#44FFFFFF" 
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Tool Selection Buttons -->
                <RadioButton x:Name="btnToolPencil" Content="✏️" ToolTip="Pencil (P)" Style="{StaticResource ToolbarToolBtn}" IsChecked="True" Click="Tool_Click" Tag="Pencil"/>
                <RadioButton x:Name="btnToolArrow" Content="↗️" ToolTip="Arrow (A)" Style="{StaticResource ToolbarToolBtn}" Click="Tool_Click" Tag="Arrow"/>
                <RadioButton x:Name="btnToolRect" Content="▭" ToolTip="Rectangle (R)" Style="{StaticResource ToolbarToolBtn}" Click="Tool_Click" Tag="Rectangle"/>
                <RadioButton x:Name="btnToolEllipse" Content="◯" ToolTip="Ellipse / Circle (E)" Style="{StaticResource ToolbarToolBtn}" Click="Tool_Click" Tag="Ellipse"/>
                <RadioButton x:Name="btnToolHighlighter" Content="🖊️" ToolTip="Highlighter (H)" Style="{StaticResource ToolbarToolBtn}" Click="Tool_Click" Tag="Highlighter"/>
                <RadioButton x:Name="btnToolBadge" Content="①" ToolTip="Step Counter Badge (B)" Style="{StaticResource ToolbarToolBtn}" Click="Tool_Click" Tag="Badge"/>
                <RadioButton x:Name="btnToolText" Content="🔤" ToolTip="Text Box (T)" Style="{StaticResource ToolbarToolBtn}" Click="Tool_Click" Tag="Text"/>

                <Rectangle Width="1" Height="20" Fill="#44FFFFFF" Margin="6,0"/>

                <!-- Thickness Picker -->
                <ComboBox x:Name="comboThickness" Width="60" VerticalAlignment="Center" Margin="2,0" SelectionChanged="Thickness_SelectionChanged">
                    <ComboBoxItem Content="2px" Tag="2" />
                    <ComboBoxItem Content="4px" Tag="4" IsSelected="True" />
                    <ComboBoxItem Content="6px" Tag="6" />
                    <ComboBoxItem Content="10px" Tag="10" />
                </ComboBox>

                <Rectangle Width="1" Height="20" Fill="#44FFFFFF" Margin="6,0"/>

                <!-- Color Palette (4 Default Colors + Color Picker) -->
                <Button x:Name="btnColorWhite" Background="#FFFFFF" Style="{StaticResource ColorPaletteBtn}" Click="Color_Click" Tag="#FFFFFF" ToolTip="White"/>
                <Button x:Name="btnColorBlack" Background="#000000" Style="{StaticResource ColorPaletteBtn}" Click="Color_Click" Tag="#000000" ToolTip="Black"/>
                <Button x:Name="btnColorDarkBlue" Background="#003366" Style="{StaticResource ColorPaletteBtn}" Click="Color_Click" Tag="#003366" ToolTip="Dark Blue"/>
                <Button x:Name="btnColorCyan" Background="#00FFFF" Style="{StaticResource ColorPaletteBtn}" Click="Color_Click" Tag="#00FFFF" ToolTip="Cyan"/>
                <Button x:Name="btnCustomColor" Content="🎨" Style="{StaticResource ToolbarActionBtn}" Click="CustomColorPicker_Click" ToolTip="Choose Custom Color"/>

                <Rectangle Width="1" Height="20" Fill="#44FFFFFF" Margin="6,0"/>

                <!-- Actions -->
                <Button Content="↩️" ToolTip="Undo (Ctrl+Z)" Click="Undo_Click" Style="{StaticResource ToolbarActionBtn}"/>
                <Button Content="🗑️" ToolTip="Clear Screen" Click="Clear_Click" Style="{StaticResource ToolbarActionBtn}"/>
                
                <Rectangle Width="1" Height="20" Fill="#44FFFFFF" Margin="6,0"/>
                
                <!-- Tab Actions -->
                <Button Content="➕" ToolTip="New Tab" Click="NewTab_Click" Style="{StaticResource ToolbarActionBtn}"/>
                <Button Content="❌" ToolTip="Close Current Tab" Click="CloseTab_Click" Style="{StaticResource ToolbarActionBtn}" Foreground="#FF6B6B"/>
                
                <Rectangle Width="1" Height="20" Fill="#44FFFFFF" Margin="6,0"/>
                
                <Button Content="🗕" ToolTip="Minimize" Click="Exit_Click" Style="{StaticResource ToolbarActionBtn}"/>
            </StackPanel>
        </Border>

        <!-- Tab Control for multiple drawing boards -->
        <TabControl x:Name="tabControl" 
                    Grid.Row="1"
                    Background="#121214"
                    BorderThickness="0"
                    SelectionChanged="tabControl_SelectionChanged"/>
    </Grid>
</Window>
